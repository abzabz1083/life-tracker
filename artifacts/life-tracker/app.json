{
  "expo": {
    "name": "Life Tracker",
    "slug": "life-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "life-tracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F4F5F1"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Life Tracker to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Life Tracker to photograph gym equipment.",
          "photosPermission": "Allow Life Tracker to choose a gym equipment photo."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
