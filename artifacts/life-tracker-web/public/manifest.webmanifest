{
  "id": "/",
  "name": "Life Tracker",
  "short_name": "Life Tracker",
  "description": "A private daily tracker for tasks, learning, money, meals, and training.",
  "start_url": "/user-portal",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8f6ee",
  "theme_color": "#303c48",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "./icons/life-tracker-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/life-tracker-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "short_name": "Today",
      "url": "/user-portal",
      "icons": [
        {
          "src": "./icons/life-tracker-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Health",
      "short_name": "Health",
      "url": "/health",
      "icons": [
        {
          "src": "./icons/life-tracker-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
